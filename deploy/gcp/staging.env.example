# Runtime environment reference for the staging Cloud Run service.
# HF_TOKEN is intentionally not listed here; inject it from Secret Manager only when needed.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Cloud Run injects PORT automatically. Keep --port=8080 on the service, but do not set PORT via --set-env-vars.
# PORT=8080
HOSTNAME=0.0.0.0
REVISION=
NUM_SHARD=1
MAX_INPUT_TOKENS=2048
MAX_TOTAL_TOKENS=3072
MAX_BATCH_PREFILL_TOKENS=4096
MAX_CONCURRENT_REQUESTS=4
DTYPE=float16
QUANTIZE=
TRUST_REMOTE_CODE=false
USAGE_STATS=off
